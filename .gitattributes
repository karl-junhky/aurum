# Source line endings stay consistent across Windows checkouts.
*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
# Скрипты и юнит своего VPN встраиваются в службу и исполняются на Linux:
# CRLF после checkout на Windows сломал бы bash на сервере.
*.sh      text eol=lf
*.service text eol=lf
*.ps1  text eol=crlf
*.nsi  text eol=crlf
*.patch text eol=lf -whitespace
cmd/affory-ui/frontend/src/shrifty/OFL-Manrope.txt -whitespace
# Исходник списка рекламы лежит байт-в-байт тем, что опубликовал HaGeZi (GPL).
internal/reklama/hagezi-*.txt -text -diff
*.srs binary
